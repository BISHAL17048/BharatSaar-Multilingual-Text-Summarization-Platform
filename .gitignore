# ==========================================
# BharatSaar - Git Ignore Configuration
# ==========================================

# --- Model Weights & Large Checkpoints (DO NOT UPLOAD) ---
model_server/weights/*
!model_server/weights/README.md
!model_server/weights/.gitkeep
weights/*
!weights/README.md
!weights/.gitkeep
*.bin
*.safetensors
*.pt
*.pth
*.onnx
*.onnx_data
*.ckpt
*.h5
*.msgpack
*.tflite
*.model
*.incomplete
*.TAG
*.metadata
*.SRC
*.TGT
.cache/
**/.cache/

# --- Virtual Environments ---
.venv/
venv/
env/
ENV/
model_server/venv/
backend/venv/

# --- Node & Frontend Dependencies and Build Outputs ---
node_modules/
**/node_modules/
dist/
**/dist/
dist-ssr/
**/dist-ssr/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Python Cache & Build Artifacts ---
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.mypy_cache/

# --- Databases & Runtime State ---
*.sqlite
*.sqlite3
*.db
celery_backend.sqlite
backend/celery_backend.sqlite
backend/chroma_data/
chroma_data/

# --- Celery / Kombu Broker Runtime Files ---
backend/control/
control/
backend/broker/out/
backend/broker/processed/

# --- Uploads & Temporary Data ---
backend/uploads/*
!backend/uploads/.gitkeep
uploads/*
!uploads/.gitkeep

# --- Environment & Secrets ---
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example

# --- IDE & OS Metadata ---
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
*.swo
*~
